{
  "name": "thunderbird-secondbrain",
  "version": "0.1.3",
  "description": "Thunderbird MailExtension for a personal second brain: saves emails into the right Obsidian file with attachments and a hashed .eml, and summarizes threads with a local Ollama model. Privacy-first.",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "author": "capazme",
  "homepage": "https://github.com/capazme/thunderbird-secondbrain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capazme/thunderbird-secondbrain.git"
  },
  "bugs": {
    "url": "https://github.com/capazme/thunderbird-secondbrain/issues"
  },
  "keywords": [
    "email",
    "llm",
    "local-ai",
    "mailextension",
    "obsidian",
    "ollama",
    "pkm",
    "privacy",
    "second-brain",
    "summarization",
    "thunderbird"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
