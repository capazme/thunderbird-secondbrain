{
  "manifest_version": 3,
  "name": "Thunderbird Second Brain",
  "version": "0.2.0",
  "description": "Salva la mail nel fascicolo Obsidian giusto (nota verbatim, allegati, .eml con SHA-256, cronologia, promesse e scadenze) e riassume il thread con un modello Ollama locale. Nessun dato lascia il tuo computer.",
  "author": "capazme",
  "homepage_url": "https://github.com/capazme/thunderbird-secondbrain",
  "browser_specific_settings": {
    "gecko": {
      "id": "tb-thread-summarizer@puzio.dev",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/capazme/thunderbird-secondbrain/main/updates.json"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "message_display_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Second Brain",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "64": "icons/icon.svg"
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "accountsRead",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:27123/*",
    "http://127.0.0.1:27123/*"
  ]
}
